{{!
    @template mod_idetestfeedback/run_detail

    Summary of a single test run: a back link and a table of run metadata.
    The individual test case results are rendered separately by
    mod_idetestfeedback/run_results, so that they can be wrapped in the
    teacher feedback form on their own.

    Example context (json):
    {
        "backurl": "https://example.com/mod/idetestfeedback/view.php?id=3",
        "meta": [
            {"label": "Student", "text": "Ada Lovelace"},
            {"label": "Commit hash", "code": "a1b2c3d"},
            {
                "label": "Status",
                "badge": {"label": "PASSED", "classes": "bg-success text-white"}
            },
            {"label": "Passed", "strong": "8 / 10"},
            {
                "label": "Flags",
                "badges": [
                    {"label": "Code capture disabled", "classes": "bg-secondary text-white"}
                ]
            }
        ]
    }
}}
<div class="mb-3">
    <a href="{{backurl}}" class="btn btn-secondary">&larr; {{#str}} back, mod_idetestfeedback {{/str}}</a>
</div>

<h2>{{#str}} rundetail, mod_idetestfeedback {{/str}}</h2>

<div class="table-responsive">
    <table class="table table-bordered w-auto mb-4">
        <tbody>
            {{#meta}}
                <tr>
                    <th scope="row">{{label}}</th>
                    <td>
                        {{#text}}{{.}}{{/text}}
                        {{#code}}<code>{{.}}</code>{{/code}}
                        {{#strong}}<span class="idetestfeedback-count">{{.}}</span>{{/strong}}
                        {{#badge}}{{> mod_idetestfeedback/status_badge }}{{/badge}}
                        {{#badges}}{{> mod_idetestfeedback/status_badge }} {{/badges}}
                    </td>
                </tr>
            {{/meta}}
        </tbody>
    </table>
</div>

<h3>{{#str}} testresults, mod_idetestfeedback {{/str}}</h3>
