{{!
    @template mod_idetestfeedback/run_results

    The individual test case results of one run.

    A result with something to show is followed by a second row spanning the
    whole table, so the code opens underneath its result rather than inside the
    narrow source cell. A result whose test was never found in the project has
    nothing to open, and says so in the cell itself.

    When the viewer may comment, each row carries a feedback textarea and this
    template is included as a partial by mod_idetestfeedback/run_feedback_form,
    which supplies the surrounding <form> and its session key. Otherwise the
    stored feedback is shown read-only.

    Example context (json):
    {
        "showrequired": true,
        "showfeedback": true,
        "cancomment": false,
        "colspan": 8,
        "rows": [
            {
                "rowclass": "table-success",
                "testsuite": "CalculatorTest",
                "testname": "testAddition",
                "badges": [
                    {"label": "Body unchanged since feedback", "classes": "bg-secondary text-white"}
                ],
                "required": true,
                "badge": {"label": "PASSED", "classes": "bg-success text-white"},
                "duration": "12 ms",
                "message": "",
                "hassource": true,
                "sourceid": "idetestfeedback-source-7",
                "source": {
                    "summary": "tests/test_calculator.py:12-13",
                    "kind": "TEST",
                    "expandable": true,
                    "wholefile": false,
                    "code": "def test_add_returns_sum():\n    assert add(2, 3) == 5",
                    "hascode": true,
                    "language": "python",
                    "linenumbers": "12\n13",
                    "hash": "b1946ac92492d234",
                    "hashlabel": "Normalised code hash",
                    "truncated": false
                },
                "feedbackname": "feedback_7",
                "feedbacklabel": "Feedback on testAddition",
                "feedback": "",
                "feedbackhtml": ""
            }
        ]
    }
}}
<div class="table-responsive">
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th scope="col">{{#str}} testsuite, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} testname, mod_idetestfeedback {{/str}}</th>
                {{#showrequired}}
                    <th scope="col">{{#str}} required, mod_idetestfeedback {{/str}}</th>
                {{/showrequired}}
                <th scope="col">{{#str}} status, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} duration, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} message, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} sourcecode, mod_idetestfeedback {{/str}}</th>
                {{#showfeedback}}
                    <th scope="col">{{#str}} feedback, mod_idetestfeedback {{/str}}</th>
                {{/showfeedback}}
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr class="{{rowclass}}">
                    <td>{{testsuite}}</td>
                    <td>
                        {{testname}}
                        {{#badges}} {{> mod_idetestfeedback/status_badge }}{{/badges}}
                    </td>
                    {{#showrequired}}
                        <td>
                            {{#required}}
                                <span class="badge bg-primary text-white">{{#str}} yes, core {{/str}}</span>
                            {{/required}}
                            {{^required}}
                                <span class="text-muted">&mdash;</span>
                            {{/required}}
                        </td>
                    {{/showrequired}}
                    <td>{{#badge}}{{> mod_idetestfeedback/status_badge }}{{/badge}}</td>
                    <td>{{duration}}</td>
                    <td>{{#message}}<pre class="idetestfeedback-message">{{.}}</pre>{{/message}}</td>
                    <td>
                        {{#hassource}}
                            {{#source.expandable}}
                                <button type="button" class="btn btn-link p-0 text-start idetestfeedback-source-toggle"
                                    data-bs-toggle="collapse" data-bs-target="#{{sourceid}}"
                                    aria-expanded="false" aria-controls="{{sourceid}}">
                                    <span class="idetestfeedback-filepath">{{source.summary}}</span>
                                </button>
                            {{/source.expandable}}
                            {{^source.expandable}}
                                <span class="idetestfeedback-filepath text-muted">{{source.summary}}</span>
                            {{/source.expandable}}
                            {{#source.truncated}}
                                <span class="badge bg-warning text-dark">
                                    {{#str}} truncated, mod_idetestfeedback {{/str}}
                                </span>
                            {{/source.truncated}}
                        {{/hassource}}
                        {{^hassource}}<span class="text-muted">&mdash;</span>{{/hassource}}
                    </td>
                    {{#showfeedback}}
                        <td>
                            {{#cancomment}}
                                <textarea name="{{feedbackname}}" rows="2" aria-label="{{feedbacklabel}}"
                                    class="form-control idetestfeedback-feedback-input">{{feedback}}</textarea>
                            {{/cancomment}}
                            {{^cancomment}}
                                {{! Already sanitised by format_text(). }}
                                {{#feedbackhtml}}{{{.}}}{{/feedbackhtml}}
                                {{^feedbackhtml}}<span class="text-muted">&mdash;</span>{{/feedbackhtml}}
                            {{/cancomment}}
                        </td>
                    {{/showfeedback}}
                </tr>
                {{#source.expandable}}
                    <tr class="idetestfeedback-source-row">
                        <td colspan="{{colspan}}" class="p-0 border-0">
                            <div class="collapse idetestfeedback-source" id="{{sourceid}}">
                                {{#source}}
                                    <div class="p-2">
                                        {{#hash}}
                                            <div class="text-muted small">
                                                {{hashlabel}}: <code>{{hash}}</code>
                                            </div>
                                        {{/hash}}
                                        {{#hascode}}
                                            <div class="idetestfeedback-code">
                                                <pre class="idetestfeedback-gutter text-muted"
                                                    aria-hidden="true">{{linenumbers}}</pre>
                                                {{#language}}<pre class="language-{{.}}"><code>{{code}}</code></pre>{{/language}}
                                                {{^language}}<pre><code>{{code}}</code></pre>{{/language}}
                                            </div>
                                        {{/hascode}}
                                        {{^hascode}}
                                            <p class="text-muted mb-0">
                                                {{#wholefile}}
                                                    {{#str}} sourcewholefile, mod_idetestfeedback {{/str}}
                                                {{/wholefile}}
                                                {{^wholefile}}
                                                    {{#str}} sourcenotcaptured, mod_idetestfeedback {{/str}}
                                                {{/wholefile}}
                                            </p>
                                        {{/hascode}}
                                    </div>
                                {{/source}}
                            </div>
                        </td>
                    </tr>
                {{/source.expandable}}
            {{/rows}}
        </tbody>
    </table>
</div>
