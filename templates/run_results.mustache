{{!
    @template mod_idetestfeedback/run_results

    The individual test case results of one run.

    When the viewer may comment, each row carries a feedback textarea and this
    template is included as a partial by mod_idetestfeedback/run_feedback_form,
    which supplies the surrounding <form> and its session key. Otherwise the
    stored feedback is shown read-only.

    Example context (json):
    {
        "showrequired": true,
        "showfeedback": true,
        "cancomment": false,
        "rows": [
            {
                "rowclass": "table-success",
                "testsuite": "CalculatorTest",
                "testname": "testAddition",
                "required": true,
                "badge": {"label": "PASSED", "classes": "bg-success text-white"},
                "duration": "12 ms",
                "message": "",
                "hassource": true,
                "source": {
                    "summary": "tests/test_calculator.py:12-13",
                    "kind": "TEST",
                    "code": "def test_add_returns_sum():\n    assert add(2, 3) == 5",
                    "hascode": true,
                    "language": "python",
                    "hash": "b1946ac92492d234",
                    "truncated": false
                },
                "feedbackname": "feedback_7",
                "feedbacklabel": "Feedback on testAddition",
                "feedback": "",
                "feedbackhtml": ""
            }
        ]
    }
}}
<div class="table-responsive">
    <table class="table table-sm table-bordered">
        <thead>
            <tr>
                <th scope="col">{{#str}} testsuite, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} testname, mod_idetestfeedback {{/str}}</th>
                {{#showrequired}}
                    <th scope="col">{{#str}} required, mod_idetestfeedback {{/str}}</th>
                {{/showrequired}}
                <th scope="col">{{#str}} status, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} duration, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} message, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} sourcecode, mod_idetestfeedback {{/str}}</th>
                {{#showfeedback}}
                    <th scope="col">{{#str}} feedback, mod_idetestfeedback {{/str}}</th>
                {{/showfeedback}}
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr class="{{rowclass}}">
                    <td>{{testsuite}}</td>
                    <td>{{testname}}</td>
                    {{#showrequired}}
                        <td>
                            {{#required}}
                                <span class="badge bg-primary text-white">{{#str}} yes, core {{/str}}</span>
                            {{/required}}
                            {{^required}}
                                <span class="text-muted">&mdash;</span>
                            {{/required}}
                        </td>
                    {{/showrequired}}
                    <td>{{#badge}}{{> mod_idetestfeedback/status_badge }}{{/badge}}</td>
                    <td>{{duration}}</td>
                    <td>{{#message}}<pre class="idetestfeedback-message">{{.}}</pre>{{/message}}</td>
                    <td>
                        {{#hassource}}
                            {{#source}}
                                <details class="idetestfeedback-source">
                                    <summary>
                                        <span class="idetestfeedback-filepath">{{summary}}</span>
                                        {{#truncated}}
                                            <span class="badge bg-warning text-dark">
                                                {{#str}} truncated, mod_idetestfeedback {{/str}}
                                            </span>
                                        {{/truncated}}
                                    </summary>
                                    {{#hash}}
                                        <div class="text-muted small">
                                            {{#str}} sourcehash, mod_idetestfeedback {{/str}}: <code>{{.}}</code>
                                        </div>
                                    {{/hash}}
                                    {{#hascode}}
                                        {{#language}}<pre class="language-{{.}}"><code>{{code}}</code></pre>{{/language}}
                                        {{^language}}<pre><code>{{code}}</code></pre>{{/language}}
                                    {{/hascode}}
                                    {{^hascode}}
                                        <p class="text-muted">{{#str}} sourcenotcaptured, mod_idetestfeedback {{/str}}</p>
                                    {{/hascode}}
                                </details>
                            {{/source}}
                        {{/hassource}}
                        {{^hassource}}<span class="text-muted">&mdash;</span>{{/hassource}}
                    </td>
                    {{#showfeedback}}
                        <td>
                            {{#cancomment}}
                                <textarea name="{{feedbackname}}" rows="2" aria-label="{{feedbacklabel}}"
                                    class="form-control idetestfeedback-feedback-input">{{feedback}}</textarea>
                            {{/cancomment}}
                            {{^cancomment}}
                                {{! Already sanitised by format_text(). }}
                                {{#feedbackhtml}}{{{.}}}{{/feedbackhtml}}
                                {{^feedbackhtml}}<span class="text-muted">&mdash;</span>{{/feedbackhtml}}
                            {{/cancomment}}
                        </td>
                    {{/showfeedback}}
                </tr>
            {{/rows}}
        </tbody>
    </table>
</div>
