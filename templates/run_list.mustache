{{!
    @template mod_idetestfeedback/run_list

    A paged list of test runs. Backs both the teacher view (every student's
    runs, with the student column and filter widgets) and the student view
    (their own runs, with a pass rate summary).

    Example context (json):
    {
        "showstudent": true,
        "summary": "",
        "totaltext": "Total: 2 run(s)",
        "filtermenus": "",
        "pagingbar": "",
        "rows": [
            {
                "student": "Ada Lovelace",
                "ide": "VSCODE",
                "projectname": "calculator",
                "commithash": "a1b2c3d4e5f60718293a4b5c6d7e8f9012345678",
                "shorthash": "a1b2c3d",
                "commiturl": "https://github.com/ada/calc/commit/a1b2c3d4e5f60718293a4b5c6d7e8f9012345678",
                "badge": {"label": "PASSED", "classes": "bg-success text-white"},
                "passed": 8,
                "failed": 0,
                "hasfailed": false,
                "date": "1 January 2026, 9:00 AM",
                "detailurl": "https://example.com/mod/idetestfeedback/view.php?id=3&runid=9"
            }
        ]
    }
}}
{{#summary}}
    <div class="alert alert-info">{{.}}</div>
{{/summary}}

{{! Pre-rendered HTML from the renderer. }}
{{{filtermenus}}}

{{#totaltext}}
    <p class="text-muted">{{.}}</p>
{{/totaltext}}

<div class="table-responsive">
    <table class="table table-striped table-bordered table-sm">
        <thead>
            <tr>
                {{#showstudent}}
                    <th scope="col">{{#str}} student, mod_idetestfeedback {{/str}}</th>
                {{/showstudent}}
                <th scope="col">{{#str}} ide, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} projectname, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} commit, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} status, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} passed, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} failed, mod_idetestfeedback {{/str}}</th>
                <th scope="col">{{#str}} timecreated, mod_idetestfeedback {{/str}}</th>
                <th scope="col"><span class="visually-hidden sr-only">{{#str}} viewdetail, mod_idetestfeedback {{/str}}</span></th>
            </tr>
        </thead>
        <tbody>
            {{#rows}}
                <tr>
                    {{#showstudent}}
                        <td>{{student}}</td>
                    {{/showstudent}}
                    <td>{{ide}}</td>
                    <td>{{projectname}}</td>
                    <td>
                        {{#commiturl}}<a href="{{.}}" title="{{commithash}}"><code>{{shorthash}}</code></a>{{/commiturl}}
                        {{^commiturl}}{{#shorthash}}<code title="{{commithash}}">{{.}}</code>{{/shorthash}}{{/commiturl}}
                    </td>
                    <td>{{#badge}}{{> mod_idetestfeedback/status_badge }}{{/badge}}</td>
                    <td><span class="text-success idetestfeedback-count">{{passed}}</span></td>
                    <td>
                        {{#hasfailed}}<span class="text-danger idetestfeedback-count">{{failed}}</span>{{/hasfailed}}
                        {{^hasfailed}}{{failed}}{{/hasfailed}}
                    </td>
                    <td>{{date}}</td>
                    <td><a href="{{detailurl}}">{{#str}} viewdetail, mod_idetestfeedback {{/str}}</a></td>
                </tr>
            {{/rows}}
        </tbody>
    </table>
</div>

{{! Pre-rendered HTML from the renderer. }}
{{{pagingbar}}}
