<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/idetestfeedback/db" VERSION="2026092304" COMMENT="XMLDB file for mod_idetestfeedback"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">

    <TABLES>
        <TABLE NAME="idetestfeedback" COMMENT="Activity instances">
            <FIELDS>
                <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course"       TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="name"         TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="intro"        TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="introformat"  TYPE="int"  LENGTH="4"  NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="assignmentkey" TYPE="char" LENGTH="32" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timeopen"     TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timeclose"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="completionpassrun" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Custom completion: student must submit a fully passing run"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="course_fk" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="assignmentkey_idx" UNIQUE="true" FIELDS="assignmentkey"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="idetestfeedback_run" COMMENT="One record per API submission">
            <FIELDS>
                <FIELD NAME="id"                TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="idetestfeedbackid" TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="userid"            TYPE="int"  LENGTH="10"  NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="ide"               TYPE="char" LENGTH="50"  NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="projectname"       TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="commithash"        TYPE="char" LENGTH="100" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="startedat"         TYPE="int"  LENGTH="18"  NOTNULL="false" SEQUENCE="false" COMMENT="Run start, epoch milliseconds"/>
                <FIELD NAME="finishedat"        TYPE="int"  LENGTH="18"  NOTNULL="false" SEQUENCE="false" COMMENT="Run end, epoch milliseconds"/>
                <FIELD NAME="status"            TYPE="char" LENGTH="10"  NOTNULL="true"  SEQUENCE="false"/>
                <FIELD NAME="passedcount"       TYPE="int"  LENGTH="6"   NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="failedcount"       TYPE="int"  LENGTH="6"   NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="skippedcount"      TYPE="int"  LENGTH="6"   NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="errorcount"        TYPE="int"  LENGTH="6"   NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated"       TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false"/>
                <FIELD NAME="capturedisabled"     TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="The student disabled source code capture for this run"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary"              TYPE="primary" FIELDS="id"/>
                <KEY NAME="idetestfeedbackid_fk" TYPE="foreign" FIELDS="idetestfeedbackid" REFTABLE="idetestfeedback" REFFIELDS="id"/>
                <KEY NAME="userid_fk"            TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="instance_user_time_idx" UNIQUE="false" FIELDS="idetestfeedbackid, userid, timecreated"/>
                <INDEX NAME="instance_status_time_idx" UNIQUE="false" FIELDS="idetestfeedbackid, status, timecreated"/>
                <INDEX NAME="instance_time_idx" UNIQUE="false" FIELDS="idetestfeedbackid, timecreated"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="idetestfeedback_result" COMMENT="Individual test case results within a run">
            <FIELDS>
                <FIELD NAME="id"             TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="true"/>
                <FIELD NAME="runid"          TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false"/>
                <FIELD NAME="testsuite"      TYPE="char" LENGTH="255" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="testname"       TYPE="char" LENGTH="1024" NOTNULL="true"  SEQUENCE="false"/>
                <FIELD NAME="status"         TYPE="char" LENGTH="10"  NOTNULL="true"  SEQUENCE="false"/>
                <FIELD NAME="durationms"     TYPE="int"  LENGTH="10"  NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="message"        TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="timecreated"    TYPE="int"  LENGTH="10"  NOTNULL="true"  SEQUENCE="false"/>
                <FIELD NAME="sourcefilepath"  TYPE="char" LENGTH="1024" NOTNULL="false" SEQUENCE="false" COMMENT="The captured file the test was found in; null when it was not found at all"/>
                <FIELD NAME="sourcestartline" TYPE="int"  LENGTH="10"   NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="sourceendline"   TYPE="int"  LENGTH="10"   NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="feedback"         TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="Optional teacher feedback on this test case result"/>
                <FIELD NAME="feedbackformat"   TYPE="int"  LENGTH="4"  NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="feedbackby"       TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="User id of the teacher who last edited the feedback"/>
                <FIELD NAME="feedbackmodified" TYPE="int"  LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="When the feedback was last edited"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary"       TYPE="primary" FIELDS="id"/>
                <KEY NAME="runid_fk"      TYPE="foreign" FIELDS="runid" REFTABLE="idetestfeedback_run" REFFIELDS="id"/>
                <KEY NAME="feedbackby_fk" TYPE="foreign" FIELDS="feedbackby" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
        </TABLE>

        <TABLE NAME="idetestfeedback_blob" COMMENT="Captured file bodies, stored once per distinct content per activity">
            <FIELDS>
                <FIELD NAME="id"                TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="true"/>
                <FIELD NAME="idetestfeedbackid" TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false"/>
                <FIELD NAME="contenthash"       TYPE="char" LENGTH="64" NOTNULL="true"  SEQUENCE="false" COMMENT="SHA-256 of content, computed here and never taken from the client"/>
                <FIELD NAME="content"           TYPE="text" NOTNULL="true"  SEQUENCE="false" COMMENT="The canonical bytes the hash was taken over; a body that canonicalises to nothing gets no row"/>
                <FIELD NAME="timecreated"       TYPE="int"  LENGTH="10" NOTNULL="true"  SEQUENCE="false" COMMENT="When this body was first seen in this activity"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary"              TYPE="primary" FIELDS="id"/>
                <KEY NAME="idetestfeedbackid_fk" TYPE="foreign" FIELDS="idetestfeedbackid" REFTABLE="idetestfeedback" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="instance_hash_idx" UNIQUE="true" FIELDS="idetestfeedbackid, contenthash"/>
            </INDEXES>
        </TABLE>

        <TABLE NAME="idetestfeedback_file" COMMENT="One row per path a run captured; the body itself lives in idetestfeedback_blob">
            <FIELDS>
                <FIELD NAME="id"          TYPE="int"  LENGTH="10"   NOTNULL="true"  SEQUENCE="true"/>
                <FIELD NAME="runid"       TYPE="int"  LENGTH="10"   NOTNULL="true"  SEQUENCE="false"/>
                <FIELD NAME="path"        TYPE="char" LENGTH="1024" NOTNULL="true"  SEQUENCE="false"/>
                <FIELD NAME="blobid"      TYPE="int"  LENGTH="10"   NOTNULL="false" SEQUENCE="false" COMMENT="The stored body; null when the run captured this path without content"/>
                <FIELD NAME="truncated"   TYPE="int"  LENGTH="1"    NOTNULL="true"  DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int"  LENGTH="10"   NOTNULL="true"  SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary"   TYPE="primary" FIELDS="id"/>
                <KEY NAME="runid_fk"  TYPE="foreign" FIELDS="runid"  REFTABLE="idetestfeedback_run"  REFFIELDS="id"/>
                <KEY NAME="blobid_fk" TYPE="foreign" FIELDS="blobid" REFTABLE="idetestfeedback_blob" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>
